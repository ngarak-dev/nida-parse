{
    "name": "ngarak-dev/nida-parse",
    "description": "A Laravel package that attempts to reverse engineer how NIDA (National Identification Authority) numbers are generated and extract basic information from National Identification Numbers (NIN) without using the official NIDA API.",
    "keywords": [
        "laravel",
        "nida",
        "nin",
        "tanzania",
        "identification",
        "parser"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ngara Wambura",
            "homepage": "https://github.com/ngarak-dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NidaParse\\": "src/"
        },
        "files": [
            "src/Helpers/nida_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NidaParse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NidaParse\\NidaParseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
